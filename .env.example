APP_NAME=xauusdt-trading-platform
ENV=development
LOG_LEVEL=INFO
DB_URL=postgresql+asyncpg://xauusdt:xauusdt@localhost:5432/xauusdt
REDIS_URL=redis://localhost:6379/0
BITGET_API_BASE=https://api.bitget.com
TZ=UTC

# --- PROJECT-MONITORING-001: Telegram alerting (optional, disabled by default) ---
# Real secrets are set only in the VPS environment, never committed.
MONITORING_TELEGRAM_ENABLED=false
MONITORING_TELEGRAM_BOT_TOKEN=
MONITORING_TELEGRAM_CHAT_ID=
MONITORING_ALERT_COOLDOWN_SECONDS=900
MONITORING_HEARTBEAT_TIMEOUT_SECONDS=180
