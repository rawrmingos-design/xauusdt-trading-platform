[Unit]
Description=XAUUSDT paper health check (PROJECT-OPS-001)
After=xauusdt-paper.service

[Service]
Type=oneshot
User=xauusdt
Group=xauusdt
EnvironmentFile=/etc/xauusdt/paper.env
# --check exits 1 when heartbeat is missing / runtime unhealthy. That triggers
# the mail/Telegram alerting path (OnFailure=) so the operator is notified.
ExecStart=/opt/xauusdt/.venv/bin/xauusdt-paper monitor health \
    --db /var/lib/xauusdt/paper_runs.db \
    --run-id ${XAUUSDT_RUN_ID} \
    --check
# Systemd marks the service failed on a non-zero exit, surfacing via journald
# and any OnFailure alert hook at the system level.